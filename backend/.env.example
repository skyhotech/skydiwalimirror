# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit it.

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# 1 for local development, 0 in production (enables HTTPS-only security).
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Studio origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Needed in production when the admin is served over HTTPS on your domain.
CSRF_TRUSTED_ORIGINS=
# 0 if a proxy (nginx, Cloudflare) already redirects HTTP to HTTPS.
DJANGO_SSL_REDIRECT=1
# Share rate-limit counters across server processes, e.g. redis://localhost:6379/0
REDIS_URL=
# Where customer selfies, posters and mirror artwork are stored (default backend/media).
MEDIA_ROOT=
# Where `manage.py backup` writes snapshots and how many to keep.
BACKUP_DIR=
BACKUP_KEEP=14
