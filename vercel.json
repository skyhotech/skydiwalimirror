{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "skydiwalimirror.vercel.app" }],
      "destination": "https://dreamdiwali-skymobile-in.vercel.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/sky/(.*)", "destination": "https://222.167.207.123/sky/$1" },
    { "source": "/api/(.*)", "destination": "https://222.167.207.123/api/$1" },
    { "source": "/static/(.*)", "destination": "https://222.167.207.123/static/$1" },
    { "source": "/media/(.*)", "destination": "https://222.167.207.123/media/$1" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/ai/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }]
    },
    {
      "source": "/frames/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
