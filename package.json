    "check": "npm run test && npm run build",
    "start": "npm run dev"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "@tailwindcss/vite": "^4.1.0",
    "@vladmandic/face-api": "1.7.15",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "vite": "^6.3.0",
    "vitest": "^5.0.5"
  }
