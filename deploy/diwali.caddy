# SKY Diwali Selfie Studio: built frontend plus Django (Sky-diwali on 127.0.0.1:8003).
# Source of truth is deploy/diwali.caddy in skydiwalimirror; deployments overwrite the server copy.
diwali.skymobile.in {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Unlike the API sites, this app needs the camera.
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
		-Via
	}
	request_body {
		max_size 36MB
	}
	# Each open stream would hold a waitress thread; the studio falls back to polling.
	handle /api/mirrors/stream/ {
		respond 404
	}
	@backend path /api/* /sky/* /django-admin/*
	handle @backend {
		reverse_proxy 127.0.0.1:8003 {
			lb_try_duration 5s
		}
	}
	handle_path /static/* {
		root * D:/sky/diwali/backend/staticfiles
		file_server
	}
	handle_path /media/* {
		root * D:/sky/diwali/media
		file_server
	}
	handle {
		root * D:/sky/diwali/site
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
