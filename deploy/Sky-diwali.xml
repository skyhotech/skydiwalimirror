<service>
  <id>Sky-diwali</id>
  <name>SKY Diwali studio API</name>
  <description>Django (waitress) for the Diwali selfie studio on 127.0.0.1:8003</description>
  <executable>D:\sky\diwali\venv\Scripts\python.exe</executable>
  <arguments>-m waitress --listen=127.0.0.1:8003 --threads=16 --trusted-proxy=127.0.0.1 --trusted-proxy-count=1 --trusted-proxy-headers=&quot;x-forwarded-for x-forwarded-proto&quot; --clear-untrusted-proxy-headers skymirror.wsgi:application</arguments>
  <workingdirectory>D:\sky\diwali\backend</workingdirectory>
  <startmode>Automatic</startmode>
  <stoptimeout>30 sec</stoptimeout>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>
  <logpath>D:\sky\diwali\service\logs</logpath>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>10</keepFiles></log>
  <env name="PYTHONUTF8" value="1"/>
</service>
