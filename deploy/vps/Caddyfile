# SKY Diwali API on the Ubuntu VPS, installed as /etc/caddy/Caddyfile.
# Needs Caddy 2.10+ for the Let's Encrypt short-lived IP certificate.
# Serves the studio, API, dashboard and media from one site.
{
	default_sni 87.232.72.141
	log default {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Referer delete
			}
		}
	}
	servers {
		timeouts {
			read_body 60s
			idle 2m
		}
	}
}

87.232.72.141 {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	encode zstd gzip
	log {
		output file /var/log/caddy/skymirror.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Referer delete
			}
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		-X-Powered-By
	}
	request_body {
		max_size 36MB
	}
	# Stream endpoint disabled; studio polls /api/mirrors/version/ instead.
	handle /api/mirrors/stream/ {
		respond 404
	}
	handle_path /static/* {
		root * /opt/skymirror/backend/staticfiles
		header Cache-Control "public, max-age=604800"
		file_server
	}
	# Uploads are served straight from disk, images only: anything else under
	# /media is refused so an uploaded file can never run as a page.
	@media_image path_regexp media_image (?i)^/media/.+\.(jpe?g|png|webp)$
	handle /media/* {
		# route preserves this security-sensitive order; ordinary handles with
		# path matchers would otherwise sort before the named image matcher.
		route {
			handle /media/customers/* {
				reverse_proxy 127.0.0.1:8000 {
					transport http {
						keepalive 30s
						keepalive_idle_conns 8
					}
				}
			}
			handle @media_image {
				root * /var/lib/skymirror
				header Cache-Control "public, max-age=31536000, s-maxage=31536000, immutable"
				header Access-Control-Allow-Origin *
				header Cross-Origin-Resource-Policy cross-origin
				header Content-Security-Policy "default-src 'none'; sandbox"
				file_server
			}
			handle {
				respond 404
			}
		}
	}
	@backend path /api/* /sky/*
	handle @backend {
		reverse_proxy 127.0.0.1:8000 {
			# Keep connections alive to Gunicorn (matches --keep-alive 5 in service).
			transport http {
				keepalive 30s
				keepalive_idle_conns 32
			}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	# A missing code file must fail as such, not come back as a page.
	handle /assets/* {
		root * /opt/skymirror/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /opt/skymirror/web
		# Pages always ask for the newest build; hashed code files never change.
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
