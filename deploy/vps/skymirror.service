# Installed as /etc/systemd/system/skymirror.service.
[Unit]
Description=SKY Diwali API (Gunicorn)
After=network.target mysql.service
Requires=mysql.service

[Service]
User=skymirror
Group=skymirror
UMask=0007
WorkingDirectory=/opt/skymirror/backend
EnvironmentFile=/etc/skymirror/.env
# 6 vCPU / 7.8 GB RAM: 6 workers × 4 threads = 24 concurrent slots.
# --preload shares Django app memory across workers (copy-on-write).
# --keep-alive 5 reuses HTTP/1.1 connections from Caddy's upstream pool.
# max-requests recycles workers to shed any per-request memory growth.
ExecStart=/opt/skymirror/venv/bin/gunicorn skymirror.wsgi:application \
  --bind 127.0.0.1:8000 --workers 6 --threads 4 --worker-class gthread --preload \
  --timeout 60 --graceful-timeout 20 --keep-alive 5 \
  --max-requests 1200 --max-requests-jitter 120 \
  --access-logfile - --error-logfile - --forwarded-allow-ips 127.0.0.1 \
  --access-logformat '{"event":"http_access","method":"%%(m)s","status":%%(s)s,"duration_us":%%(D)s,"request_id":"%%({x-request-id}o)s","route":"%%({x-route-name}o)s"}'
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
# 7.8 GB total RAM budget:
#   MySQL         ~600 MB
#   OS + Caddy    ~300 MB
#   6 × gunicorn  ~1.2 GB (preloaded Django; workers share read-only pages)
#   Headroom       ~600 MB
# Leaves ~5 GB for the gunicorn process group.
MemoryHigh=4500M
MemoryMax=5500M
TasksMax=400
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/skymirror /var/log/skymirror
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
